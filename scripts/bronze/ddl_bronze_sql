
/* 
====================================================================================
DDL SCRIPT: create Bronze Tables
====================================================================================
*/
    USE [datawarehouse]; 
    GO

    SET ANSI_NULLS ON;
    SET QUOTED_IDENTIFIER ON;
    GO

create or alter procedure bronze.load_bronze as 
BEGIN
    -------------------------------------------------------------------------------
    -- CRM DATASETS
    -------------------------------------------------------------------------------

    -- 1. bronze.crm_customers
    IF OBJECT_ID('bronze.crm_customers', 'U') IS NOT NULL
        DROP TABLE bronze.crm_customers;
   

    CREATE TABLE bronze.crm_customers (
        customer_id              VARCHAR(50)   NULL,
        customer_unique_id       VARCHAR(50)   NULL,
        customer_zip_code_prefix VARCHAR(20)   NULL,
        customer_city            NVARCHAR(100) NULL,
        customer_state           VARCHAR(10)   NULL
    );
   
    PRINT 'Loading bronze.crm_customers...';

    BULK INSERT bronze.crm_customers
    FROM 'C:\CRM\olist_customers_dataset.csv'
    WITH (
        FORMAT = 'CSV',
        FIRSTROW = 2,
        FIELDQUOTE = '"',
        FIELDTERMINATOR = ',',
        ROWTERMINATOR = '0x0a',
        CODEPAGE = '65001',
        TABLOCK
    );
    

    -- 2. bronze.crm_order_review
    IF OBJECT_ID('bronze.crm_order_review', 'U') IS NOT NULL
        DROP TABLE bronze.crm_order_review;
   

    CREATE TABLE bronze.crm_order_review (
        review_id               VARCHAR(50)   NULL,
        order_id                VARCHAR(50)   NULL,
        review_score            VARCHAR(10)   NULL,
        review_comment_title    NVARCHAR(255) NULL,
        review_comment_message  NVARCHAR(MAX) NULL,
        review_creation_date    VARCHAR(50)   NULL,
        review_answer_timestamp VARCHAR(50)   NULL
    );
   

    PRINT 'Loading bronze.crm_order_review...';

    BULK INSERT bronze.crm_order_review
    FROM 'C:\CRM\olist_order_reviews_dataset.csv'
    WITH (
        FORMAT = 'CSV',
        FIRSTROW = 2,
        FIELDQUOTE = '"',
        FIELDTERMINATOR = ',',
        ROWTERMINATOR = '0x0a',
        CODEPAGE = '65001',
        TABLOCK
    );
  
    -------------------------------------------------------------------------------
    -- ERP DATASETS
    -------------------------------------------------------------------------------
    create table bronze.erp_product_category(
    product_category_name nvarchar(100),
    product_category_name_english nvarchar(100)
    );

       PRINT 'Loading bronze.erp_product_category...';

    BULK INSERT bronze.erp_product_category
    FROM 'C:\ERP\product_category_name_translation.csv'
    WITH (
        FORMAT = 'CSV',
        FIRSTROW = 2,
        FIELDQUOTE = '"',
        FIELDTERMINATOR = ',',
        ROWTERMINATOR = '0x0a',
        CODEPAGE = '65001',
        TABLOCK
    );
    
    -- 4. bronze.erp_geolocation
    IF OBJECT_ID('bronze.erp_geolocation', 'U') IS NOT NULL
        DROP TABLE bronze.erp_geolocation;
    

    CREATE TABLE bronze.erp_geolocation (
        geolocation_zip_code_prefix VARCHAR(20)     NULL,
        geolocation_lat            DECIMAL(18, 15) NULL,
        geolocation_lng            DECIMAL(18, 15) NULL,
        geolocation_city           NVARCHAR(100)   NULL,
        geolocation_state          VARCHAR(10)      NULL
    );
    

    PRINT 'Loading bronze.erp_geolocation...';

    BULK INSERT bronze.erp_geolocation
    FROM 'C:\ERP\olist_geolocation_dataset.csv'
    WITH (
        FORMAT = 'CSV',
        FIRSTROW = 2,
        FIELDQUOTE = '"',
        FIELDTERMINATOR = ',',
        ROWTERMINATOR = '0x0a',
        CODEPAGE = '65001',
        TABLOCK
    );
    

    -- 5. bronze.erp_order_item
    IF OBJECT_ID('bronze.erp_order_item', 'U') IS NOT NULL
        DROP TABLE bronze.erp_order_item;
    

    CREATE TABLE bronze.erp_order_item (
        order_id            VARCHAR(50)   NULL,
        order_item_id       INT           NULL,
        product_id          VARCHAR(50)   NULL,
        seller_id           VARCHAR(50)   NULL,
        shipping_limit_date VARCHAR(50)   NULL,
        price               DECIMAL(10,2) NULL,
        freight_value       DECIMAL(10,2) NULL
    );
    

    PRINT 'Loading bronze.erp_order_item...';

    BULK INSERT bronze.erp_order_item
    FROM 'C:\ERP\olist_order_items_dataset.csv'
    WITH (
        FORMAT = 'CSV',
        FIRSTROW = 2,
        FIELDQUOTE = '"',
        FIELDTERMINATOR = ',',
        ROWTERMINATOR = '0x0a',
        CODEPAGE = '65001',
        TABLOCK
    );
    

    -- 6. bronze.erp_order_payment
    IF OBJECT_ID('bronze.erp_order_payment', 'U') IS NOT NULL
        DROP TABLE bronze.erp_order_payment;
    

    CREATE TABLE bronze.erp_order_payment (
        order_id             VARCHAR(50)   NULL,
        payment_sequential   INT           NULL,
        payment_type         VARCHAR(50)   NULL,
        payment_installments INT           NULL,
        payment_value        DECIMAL(10,2) NULL
    );
    

    PRINT 'Loading bronze.erp_order_payment...';

    BULK INSERT bronze.erp_order_payment
    FROM 'C:\ERP\olist_order_payments_dataset.csv'
    WITH (
        FORMAT = 'CSV',
        FIRSTROW = 2,
        FIELDQUOTE = '"',
        FIELDTERMINATOR = ',',
        ROWTERMINATOR = '0x0a',
        CODEPAGE = '65001',
        TABLOCK
    );
    

    -- 7. bronze.erp_order_info
    IF OBJECT_ID('bronze.erp_order_info', 'U') IS NOT NULL
        DROP TABLE bronze.erp_order_info;
    

    CREATE TABLE bronze.erp_order_info (
        order_id                    VARCHAR(50) NULL,
        customer_id                 VARCHAR(50) NULL,
        order_status                VARCHAR(30) NULL,
        order_purchase_timestamp    VARCHAR(50) NULL,
        order_approved_at           VARCHAR(50) NULL,
        order_delivered_carrier_date VARCHAR(50) NULL,
        order_delivered_customer_date VARCHAR(50) NULL,
        order_estimated_delivery_date VARCHAR(50) NULL
    );
    

    PRINT 'Loading bronze.erp_order_info...';

    BULK INSERT bronze.erp_order_info
    FROM 'C:\ERP\olist_orders_dataset.csv'
    WITH (
        FORMAT = 'CSV',
        FIRSTROW = 2,
        FIELDQUOTE = '"',
        FIELDTERMINATOR = ',',
        ROWTERMINATOR = '0x0a',
        CODEPAGE = '65001',
        TABLOCK
    );
    

    -- 8. bronze.erp_product_info
    IF OBJECT_ID('bronze.erp_product_info', 'U') IS NOT NULL
        DROP TABLE bronze.erp_product_info;
    

    CREATE TABLE bronze.erp_product_info (
        product_id                 VARCHAR(50)   NULL,
        product_category_name      NVARCHAR(100) NULL,
        product_name_lenght        INT           NULL,
        product_description_lenght INT           NULL,
        product_photos_qty         INT           NULL,
        product_weight_g           INT           NULL,
        product_length_cm          INT           NULL,
        product_height_cm          INT           NULL,
        product_width_cm           INT           NULL
    );
    

    PRINT 'Loading bronze.erp_product_info...';

    BULK INSERT bronze.erp_product_info
    FROM 'C:\ERP\olist_products_dataset.csv'
    WITH (
        FORMAT = 'CSV',
        FIRSTROW = 2,
        FIELDQUOTE = '"',
        FIELDTERMINATOR = ',',
        ROWTERMINATOR = '0x0a',
        CODEPAGE = '65001',
        TABLOCK
    );
    

    -- 9. bronze.erp_sellers_info
    IF OBJECT_ID('bronze.erp_sellers_info', 'U') IS NOT NULL
        DROP TABLE bronze.erp_sellers_info;
    

    CREATE TABLE bronze.erp_sellers_info (
        seller_id              VARCHAR(50)   NULL,
        seller_zip_code_prefix VARCHAR(20)   NULL,
        seller_city            NVARCHAR(100) NULL,
        seller_state           VARCHAR(10)   NULL
    );
    

    PRINT 'Loading bronze.erp_sellers_info...';

    BULK INSERT bronze.erp_sellers_info
    FROM 'C:\ERP\olist_sellers_dataset.csv'
    WITH (
        FORMAT = 'CSV',
        FIRSTROW = 2,
        FIELDQUOTE = '"',
        FIELDTERMINATOR = ',',
        ROWTERMINATOR = '0x0a',
        CODEPAGE = '65001',
        TABLOCK
    );


-------------------------------------------------------------------------------
-- VERIFICATION
-------------------------------------------------------------------------------
SELECT 'bronze.crm_customers' AS table_name, COUNT(*) AS total_records FROM bronze.crm_customers
UNION ALL 
SELECT 'bronze.crm_order_review', COUNT(*) FROM bronze.crm_order_review
UNION ALL 
SELECT 'bronze.crm_product_info', COUNT(*) FROM bronze.crm_product_info
UNION ALL 
SELECT 'bronze.erp_geolocation', COUNT(*) FROM bronze.erp_geolocation
UNION ALL 
SELECT 'bronze.erp_order_item', COUNT(*) FROM bronze.erp_order_item
UNION ALL 
SELECT 'bronze.erp_order_payment', COUNT(*) FROM bronze.erp_order_payment
UNION ALL 
SELECT 'bronze.erp_order_info', COUNT(*) FROM bronze.erp_order_info
UNION ALL 
SELECT 'bronze.erp_product_info', COUNT(*) FROM bronze.erp_product_info
UNION ALL 
SELECT 'bronze.erp_sellers_info', COUNT(*) FROM bronze.erp_sellers_info;;
END;
GO
